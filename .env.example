# Postgres with the pgvector extension (Neon / Supabase free tier both work)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Required — embeddings (text-embedding-3-small). Also used for answers if no Anthropic key is set.
OPENAI_API_KEY=""

# Optional — if set, answers are generated by Claude instead of OpenAI
ANTHROPIC_API_KEY=""

# Optional overrides
# ANTHROPIC_MODEL="claude-sonnet-4-5"
# OPENAI_CHAT_MODEL="gpt-4o-mini"
